{
  "name": "palaguidebot-api-adonis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#bot/*": "./app/bot/*.js",
    "#cache/*": "./app/cache/*.js",
    "#core/*": "./app/core/*.js",
    "#event/*": "./app/event/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#leaderboard/*": "./app/leaderboard/*.js",
    "#link/*": "./app/link/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#minecraft/*": "./app/minecraft/*.js",
    "#models/*": "./app/models/*.js",
    "#other/*": "./app/other/*.js",
    "#paladium/*": "./app/paladium/*.js",
    "#user/*": "./app/user/*.js",
    "#status/*": "./app/status/*.js",
    "#unique/*": "./app/unique/*.js",
    "#usage/*": "./app/usage/*.js",
    "#utils/*": "./app/utils/*.js",
    "#docs/*": "./app/docs/*.js",
    "#app/*": "./app/*.js",
    "#commands/*": "./commands/*.js",
    "#providers/*": "./providers/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.8.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/core": "^7.3.5",
    "@adonisjs/cors": "^3.0.0",
    "@humanfs/node": "^0.16.8",
    "@vinejs/vine": "^4.4.0",
    "adonisjs-scheduler": "^2.8.0",
    "bentocache": "^1.6.1",
    "ky": "^2.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.7",
    "nanoid": "^5.1.7",
    "node-cron": "^4.6.0",
    "reflect-metadata": "^0.2.2"
  },
  "overrides": {
    "adonisjs-scheduler": {
      "node-cron": "4.6.0"
    }
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/**/middleware/**/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "allowScripts": {
    "@swc/core@1.15.46": true
  }
}
