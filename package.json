{
  "name": "palaguidebot-api-adonis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#bot/*": "./app/bot/*.js",
    "#cache/*": "./app/cache/*.js",
    "#core/*": "./app/core/*.js",
    "#event/*": "./app/event/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#leaderboard/*": "./app/leaderboard/*.js",
    "#link/*": "./app/link/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#minecraft/*": "./app/minecraft/*.js",
    "#models/*": "./app/models/*.js",
    "#other/*": "./app/other/*.js",
    "#paladium/*": "./app/paladium/*.js",
    "#user/*": "./app/user/*.js",
    "#status/*": "./app/status/*.js",
    "#unique/*": "./app/unique/*.js",
    "#usage/*": "./app/usage/*.js",
    "#utils/*": "./app/utils/*.js",
    "#commands/*": "./commands/*.js",
    "#providers/*": "./providers/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.7.0",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@japa/api-client": "^2.0.3",
    "@japa/assert": "^3.0.0",
    "@japa/plugin-adonisjs": "^3.0.1",
    "@japa/runner": "^3.1.4",
    "@swc/core": "^1.6.3",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.5",
    "@types/node-cron": "^3.0.11",
    "@types/pidusage": "^2.0.5",
    "eslint": "^8.57.0",
    "hot-hook": "^0.2.6",
    "pino-pretty": "^11.2.1",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@adonisjs/core": "^6.12.0",
    "@adonisjs/cors": "^2.2.1",
    "@vinejs/vine": "^2.1.0",
    "adonisjs-scheduler": "^1.0.5",
    "bentocache": "^1.0.0-beta.9",
    "ky": "^1.4.0",
    "luxon": "^3.4.4",
    "mongoose": "^8.4.5",
    "nanoid": "^5.0.7",
    "node-cron": "^3.0.3",
    "pidusage": "^3.0.2",
    "pm2": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.7.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
