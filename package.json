{
  "name": "palaguidebot-api-adonis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#bot/*": "./app/bot/*.js",
    "#cache/*": "./app/cache/*.js",
    "#core/*": "./app/core/*.js",
    "#event/*": "./app/event/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#leaderboard/*": "./app/leaderboard/*.js",
    "#link/*": "./app/link/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#minecraft/*": "./app/minecraft/*.js",
    "#models/*": "./app/models/*.js",
    "#other/*": "./app/other/*.js",
    "#paladium/*": "./app/paladium/*.js",
    "#user/*": "./app/user/*.js",
    "#status/*": "./app/status/*.js",
    "#unique/*": "./app/unique/*.js",
    "#usage/*": "./app/usage/*.js",
    "#utils/*": "./app/utils/*.js",
    "#commands/*": "./commands/*.js",
    "#providers/*": "./providers/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.0.0-beta.7",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@swc/core": "^1.10.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.19.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "ts-node-maintained": "^10.9.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@adonisjs/core": "^6.17.1",
    "@adonisjs/cors": "^2.2.1",
    "@vinejs/vine": "^3.0.0",
    "adonisjs-scheduler": "^2.0.0",
    "bentocache": "^1.0.0",
    "ky": "^1.7.4",
    "luxon": "^3.5.0",
    "mongoose": "^8.9.7",
    "nanoid": "^5.0.9",
    "node-cron": "^3.0.3",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/**/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
